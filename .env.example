# Copy to .env and run: node --env-file=.env src/run.js
# The defaults already match docker-compose.yml, so you only need this file
# if you point the test at your own databases.

ABORTLAB_PG_URL=postgres://abortlab:abortlab@127.0.0.1:55432/abortlab
ABORTLAB_MYSQL_URL=mysql://abortlab:abortlab@127.0.0.1:53306/abortlab

# How long the test query runs on the server.
ABORTLAB_SLEEP_MS=3000
# How long to wait, after the database shows the query running, before aborting.
ABORTLAB_ABORT_AFTER_MS=500
# A query counts as stopped if the database is idle within this window after the abort.
ABORTLAB_STOP_THRESHOLD_MS=1000
# How often the observer connection polls the database.
ABORTLAB_POLL_MS=50
